<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NCMDumperGUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NCMDumperGUI.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="* , 4*">
        <!-- 主面板:START -->
        <Border Grid.Row="0" 
                Margin="25 15 25 10"
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="15">
            
            <Grid RowDefinitions="*, Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="2* , *">
                
                    <Border Grid.Column="0"
                        Margin="15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0 0 10 0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Run Text="已选择："/>
                                <Run Text="{Binding PickedCount}"/>
                                <Run Text="个"/>
                            </TextBlock>
                            
                            <Rectangle Width="1" Fill="LightGray" Margin="0,2,10,2"/>
                            
                            <TextBlock Margin="0 0 10 0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Run Text="已处理："/>
                                <Run Text="{Binding DumpedCount}"/>
                                <Run Text="个"/>
                            </TextBlock>
                            
                            <Rectangle Width="1" Fill="LightGray" Margin="0,2,10,2"/>
                            
                            <TextBlock Margin="0 0 10 0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <Run Text="失败："/>
                                <Run Text="{Binding FailedCount}"/>
                                <Run Text="个"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                
                    <Border Grid.Column="1"
                        Margin="15">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择文件"
                                    Click="FilePick_ClickAsync"
                                    Margin="0 0 5 0"/>
                            <Button Content="开始解密"
                                    Command="{Binding DumpCommand}"
                                    Name="DumpButton"/>
                        </StackPanel>
                    </Border>
                
                </Grid>
            </Grid>
            
        </Border>
        <!-- 主面板:END -->
        
        <!-- 任务列表:START -->
        <Border Grid.Row="1"
                Margin="25 10 25 25"
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="15"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnDragOver"
                DragDrop.Drop="OnDrop">
            
            <ScrollViewer>
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="添加或拖放 .ncm 文件到此处"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Margin="5"/>
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Files}"
                                  Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DumpItem">
                                <Border Padding="10 6" Margin="0 2"
                                        CornerRadius="6" Background="#0A000000">
                                    <Grid ColumnDefinitions="*, Auto, 90">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ErrorMessage}"
                                                   Foreground="OrangeRed"
                                                   FontSize="11"
                                                   Margin="8,0"
                                                   MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <!-- 状态文字随枚举显示 -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Status}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            
        </Border>
        <!-- 任务列表:END -->
    </Grid>
    
</UserControl>
